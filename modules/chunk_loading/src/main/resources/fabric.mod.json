{
  "schemaVersion": 1,
  "id": "porting_lib_chunk_loading",
  "version": "${version}",
  "name": "Porting Lib Chunk Loading",
  "description": "Chunk Loader API",
  "entrypoints": {
    "main": [
      "io.github.fabricators_of_create.porting_lib.chunk.loading.PortingLibChunkLoading::init"
    ]
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_3230": ["io/github/fabricators_of_create/porting_lib/chunk/loading/extensions/TicketTypeExtension"],
      "net/minecraft/class_10592": ["io/github/fabricators_of_create/porting_lib/chunk/loading/extensions/TicketStorageExtension"]
    }
  }
}
